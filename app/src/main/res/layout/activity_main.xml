<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="8dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/selected_items_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default" />

        <Button
            android:id="@+id/selected_items_custom_icon_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Icon" />

        <Button
            android:id="@+id/selected_items_custom_highlight_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Highlight" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/no_search_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Search" />

        <Button
            android:id="@+id/sort_to_top_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort To Top" />

        <Button
            android:id="@+id/divider_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Divider" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/custom_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Padding" />

        <Button
            android:id="@+id/everything_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Everything" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Selected items"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/selected_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>